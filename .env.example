# PostgreSQL 16 creates only this empty database and user. Laravel owns all DDL and seed data.
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Laravel API configuration
APP_ENV=local
API_PORT=8000
LARAVEL_APP_KEY=replace-with-a-laravel-application-key
JWT_SECRET=replace-with-a-local-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-admin-password
CORS_ORIGIN=http://localhost:5173

# React frontend configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
